# Скопируйте этот файл в .env и заполните своими значениями
PORT=3000

PGHOST=localhost
PGPORT=5432
PGDATABASE=shop_admin
PGUSER=postgres
PGPASSWORD=postgres

SESSION_SECRET=change_this_to_a_random_long_string

# Логин/пароль администратора, который создастся при npm run initdb
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
